<Window x:Class="IntervalToast.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="IntervalToast Notification"
        Height="120" Width="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False">

    <Window.Resources>
        <!-- Drop shadow effect for the notification -->
        <DropShadowEffect x:Key="NotificationShadow"
                          Color="Black"
                          Opacity="0.3"
                          BlurRadius="10"
                          ShadowDepth="3"
                          Direction="270" />

        <!-- Style for the close button -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main notification container with rounded corners -->
    <Border x:Name="NotificationBorder"
            Background="#F0F0F0"
            CornerRadius="8"
            Effect="{StaticResource NotificationShadow}"
            Margin="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with title and close button -->
            <Grid Grid.Row="0" Margin="12,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleTextBlock"
                           Grid.Column="0"
                           Text="Interval Reminder"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#333"
                           VerticalAlignment="Center"/>

                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Content="×"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click"
                        Width="24"
                        Height="24"/>
            </Grid>

            <!-- Content area -->
            <Grid Grid.Row="1" Margin="12,4,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon area -->
                <Border x:Name="IconBorder"
                        Grid.Column="0"
                        Width="24"
                        Height="24"
                        CornerRadius="12"
                        Background="#4A90E2"
                        VerticalAlignment="Top"
                        Margin="0,4,12,0">
                    <TextBlock Text="⏰"
                               Foreground="White"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Message content -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="MessageTextBlock"
                               Text="Time for a break! Remember to take care of yourself."
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#555"
                               TextWrapping="Wrap"
                               LineHeight="16"/>

                    <TextBlock x:Name="TimestampTextBlock"
                               Text="Just now"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               Foreground="#888"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>