<Window x:Class="IntervalToast.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="IntervalToast Notification"
        Height="120" Width="350"
        MinHeight="120" MaxHeight="120"
        MinWidth="350" MaxWidth="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False">

    <Window.Resources>
        <!-- Drop shadow effect for the notification -->
        <DropShadowEffect x:Key="NotificationShadow"
                          Color="Black"
                          Opacity="0.3"
                          BlurRadius="10"
                          ShadowDepth="3"
                          Direction="270" />

        <!-- Enhanced drop shadow for hover effects -->
        <DropShadowEffect x:Key="NotificationShadowEnhanced"
                          Color="Black"
                          Opacity="0.4"
                          BlurRadius="15"
                          ShadowDepth="5"
                          Direction="270" />

        <!-- Blur effect for background -->
        <BlurEffect x:Key="NotificationBlur"
                    Radius="5" />

        <!-- Glow effect for enhanced visuals -->
        <DropShadowEffect x:Key="NotificationGlow"
                          Color="#4A90E2"
                          Opacity="0.6"
                          BlurRadius="20"
                          ShadowDepth="0" />

        <!-- Progress bar styles for different positions -->
        <Style x:Key="BottomProgressBarStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="#4A90E2"/>
            <Setter Property="Height" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Width" Value="0"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <Style x:Key="TopProgressBarStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="#4A90E2"/>
            <Setter Property="Height" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Width" Value="0"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <Style x:Key="LeftProgressBorderStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="#4A90E2"/>
            <Setter Property="Width" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <Style x:Key="RightProgressBorderStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="#4A90E2"/>
            <Setter Property="Width" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <!-- Circular progress indicator style -->
        <Style x:Key="CircularProgressStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stroke" Value="#4A90E2"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="StrokeDashArray" Value="0,100"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="-90"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for the close button -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main notification container with rounded corners -->
    <Border x:Name="NotificationBorder"
            Background="#F0F0F0"
            CornerRadius="8"
            Effect="{StaticResource NotificationShadow}"
            Margin="10">

        <!-- Progress indicators overlay -->
        <Grid>
            <!-- Bottom progress bar -->
            <Rectangle x:Name="BottomProgressBar"
                       Style="{StaticResource BottomProgressBarStyle}"
                       Visibility="Collapsed"/>

            <!-- Top progress bar -->
            <Rectangle x:Name="TopProgressBar"
                       Style="{StaticResource TopProgressBarStyle}"
                       Visibility="Collapsed"/>

            <!-- Left progress border -->
            <Rectangle x:Name="LeftProgressBorder"
                       Style="{StaticResource LeftProgressBorderStyle}"
                       Visibility="Collapsed"/>

            <!-- Right progress border -->
            <Rectangle x:Name="RightProgressBorder"
                       Style="{StaticResource RightProgressBorderStyle}"
                       Visibility="Collapsed"/>

            <!-- Circular progress indicator (corner) -->
            <Ellipse x:Name="CircularProgressCorner"
                     Style="{StaticResource CircularProgressStyle}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,8,8,0"
                     Visibility="Collapsed"/>

            <!-- Circular progress indicator (center overlay) -->
            <Ellipse x:Name="CircularProgressCenter"
                     Style="{StaticResource CircularProgressStyle}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Width="40"
                     Height="40"
                     StrokeThickness="3"
                     Opacity="0.7"
                     Visibility="Collapsed"/>

            <!-- Overflow and scroll indicators -->
            <Grid x:Name="OverflowIndicators" Visibility="Collapsed">
                <!-- Top scroll indicator -->
                <Rectangle x:Name="TopScrollIndicator"
                           Fill="#4A90E2"
                           Height="2"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top"
                           Opacity="0.7"
                           Visibility="Collapsed"/>

                <!-- Bottom scroll indicator -->
                <Rectangle x:Name="BottomScrollIndicator"
                           Fill="#4A90E2"
                           Height="2"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Bottom"
                           Opacity="0.7"
                           Visibility="Collapsed"/>

                <!-- Left scroll indicator -->
                <Rectangle x:Name="LeftScrollIndicator"
                           Fill="#4A90E2"
                           Width="2"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Stretch"
                           Opacity="0.7"
                           Visibility="Collapsed"/>

                <!-- Right scroll indicator -->
                <Rectangle x:Name="RightScrollIndicator"
                           Fill="#4A90E2"
                           Width="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Stretch"
                           Opacity="0.7"
                           Visibility="Collapsed"/>

                <!-- Overflow count badge -->
                <Border x:Name="OverflowBadge"
                        Background="Orange"
                        CornerRadius="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,8,8"
                        Padding="6,2"
                        Visibility="Collapsed">
                    <TextBlock x:Name="OverflowCountText"
                               Text="+5"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="Bold"/>
                </Border>
            </Grid>

            <!-- Main content grid -->
            <Grid x:Name="MainContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

            <!-- Header with title and close button -->
            <Grid Grid.Row="0" Margin="12,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleTextBlock"
                           Grid.Column="0"
                           Text="Interval Reminder"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#333"
                           VerticalAlignment="Center"/>

                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Content="×"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click"
                        Width="24"
                        Height="24"/>
            </Grid>

            <!-- Content area -->
            <Grid Grid.Row="1" Margin="12,4,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon area with category indicator -->
                <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,4,12,0">
                    <Border x:Name="IconBorder"
                            Width="24"
                            Height="24"
                            CornerRadius="12"
                            Background="#4A90E2">
                        <TextBlock x:Name="CategoryIconText"
                                   Text="⏰"
                                   Foreground="White"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Priority indicator badge -->
                    <Border x:Name="PriorityIndicator"
                            Width="8"
                            Height="8"
                            CornerRadius="4"
                            Background="Red"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-2,-2,0"
                            Visibility="Collapsed"/>

                    <!-- Category border indicator -->
                    <Border x:Name="CategoryBorder"
                            Width="26"
                            Height="26"
                            CornerRadius="13"
                            BorderThickness="2"
                            BorderBrush="#4A90E2"
                            Visibility="Collapsed"/>
                </Grid>

                <!-- Message content -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="MessageTextBlock"
                               Text="Time for a break! Remember to take care of yourself."
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#555"
                               TextWrapping="Wrap"
                               LineHeight="16"/>

                    <TextBlock x:Name="TimestampTextBlock"
                               Text="Just now"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               Foreground="#888"
                               Margin="0,4,0,0"/>
                </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>