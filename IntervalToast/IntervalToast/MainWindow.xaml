<Window x:Class="IntervalToast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IntervalToast"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="IntervalToast - Configuration Dashboard" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="900"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ConfigButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5BA0F2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3A80D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ConfigButtonStyle}">
            <Setter Property="Background" Value="#6C757D"/>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ConfigButtonStyle}">
            <Setter Property="Background" Value="#DC3545"/>
        </Style>

        <!-- Success Button Style -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ConfigButtonStyle}">
            <Setter Property="Background" Value="#28A745"/>
        </Style>

        <!-- Card Panel Style -->
        <Style x:Key="CardPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Tab Style -->
        <Style x:Key="ConfigTabStyle" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="IntervalToast Configuration Dashboard"
                               FontFamily="Segoe UI"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Phase 5: Advanced Configuration &amp; Management Interface"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               Foreground="#BDC3C7"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeToTrayBtn"
                            Content="Minimize to Tray"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="MinimizeToTrayBtn_Click"
                            Margin="0,0,10,0"/>
                    <Button x:Name="QuickTestBtn"
                            Content="Quick Test"
                            Style="{StaticResource ConfigButtonStyle}"
                            Click="QuickTestBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content with tab control -->
        <TabControl Grid.Row="1" Margin="20" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource ConfigTabStyle}"/>
            </TabControl.Resources>

            <!-- Dashboard Tab -->
            <TabItem Header="Dashboard" IsSelected="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>

                        <!-- System Status Overview -->
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="System Status" Style="{StaticResource SectionHeaderStyle}"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Cards -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="#E8F5E8" CornerRadius="6" Padding="15" Margin="5">
                                        <StackPanel>
                                            <TextBlock x:Name="NotificationSystemStatusText" Text="System Active" FontWeight="Bold" Foreground="#27AE60" FontSize="14"/>
                                            <TextBlock Text="Notification System" FontSize="12" Foreground="#555"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1" Background="#E8F4FD" CornerRadius="6" Padding="15" Margin="5">
                                        <StackPanel>
                                            <TextBlock x:Name="ActiveNotificationsText" Text="0 Active" FontWeight="Bold" Foreground="#3498DB" FontSize="14"/>
                                            <TextBlock Text="Notifications" FontSize="12" Foreground="#555"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="2" Background="#FDF4E8" CornerRadius="6" Padding="15" Margin="5">
                                        <StackPanel>
                                            <TextBlock x:Name="QueuedNotificationsText" Text="0 Queued" FontWeight="Bold" Foreground="#F39C12" FontSize="14"/>
                                            <TextBlock Text="In Queue" FontSize="12" Foreground="#555"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Quick Actions -->
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                        <Button x:Name="DismissAllBtn" Content="Dismiss All" Style="{StaticResource DangerButtonStyle}" Click="DismissAllBtn_Click"/>
                                        <Button x:Name="ShowQueueStatusBtn" Content="Queue Status" Style="{StaticResource ConfigButtonStyle}" Click="ShowQueueStatusBtn_Click"/>
                                        <Button x:Name="ToggleSystemBtn" Content="Pause System" Style="{StaticResource SecondaryButtonStyle}" Click="ToggleSystemBtn_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Quick Test Section -->
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Quick Notification Tests" Style="{StaticResource SectionHeaderStyle}"/>

                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="ShowInfoBtn" Content="Info" Style="{StaticResource ConfigButtonStyle}" Background="#17A2B8" Click="ShowInfoBtn_Click"/>
                                    <Button x:Name="ShowSuccessBtn" Content="Success" Style="{StaticResource SuccessButtonStyle}" Click="ShowSuccessBtn_Click"/>
                                    <Button x:Name="ShowWarningBtn" Content="Warning" Style="{StaticResource ConfigButtonStyle}" Background="#FFC107" Click="ShowWarningBtn_Click"/>
                                    <Button x:Name="ShowErrorBtn" Content="Error" Style="{StaticResource DangerButtonStyle}" Click="ShowErrorBtn_Click"/>
                                    <Button x:Name="ShowSystemBtn" Content="System" Style="{StaticResource SecondaryButtonStyle}" Click="ShowSystemBtn_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Recent Activity -->
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Recent Activity" Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBlock x:Name="RecentActivityText" Text="No recent notifications" FontSize="12" Foreground="#666" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Theme Editor Tab -->
            <TabItem Header="Theme Editor">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Visual Theme Configuration" Style="{StaticResource SectionHeaderStyle}"/>

                                <!-- Theme Presets -->
                                <TextBlock Text="Quick Presets:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Button x:Name="ApplyLightThemeBtn" Content="Light Theme" Style="{StaticResource ConfigButtonStyle}" Click="ApplyLightThemeBtn_Click"/>
                                    <Button x:Name="ApplyDarkThemeBtn" Content="Dark Theme" Style="{StaticResource SecondaryButtonStyle}" Click="ApplyDarkThemeBtn_Click"/>
                                    <Button x:Name="ApplyMinimalThemeBtn" Content="Minimal" Style="{StaticResource ConfigButtonStyle}" Background="#6C757D" Click="ApplyMinimalThemeBtn_Click"/>
                                </WrapPanel>

                                <!-- Live Preview Area -->
                                <TextBlock Text="Live Preview:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Border x:Name="ThemePreviewArea" Background="#F8F9FA" CornerRadius="6" Padding="20" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Preview Area" FontSize="14" Foreground="#666"/>
                                        <Button Content="Test Live Preview" Style="{StaticResource ConfigButtonStyle}" Click="TestLivePreviewBtn_Click" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Statistics Tab -->
            <TabItem Header="Statistics">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Notification Analytics" Style="{StaticResource SectionHeaderStyle}"/>

                                <!-- Statistics Overview -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Background="#E8F5E8" CornerRadius="6" Padding="15" Margin="5">
                                        <StackPanel>
                                            <TextBlock x:Name="TotalNotificationsText" Text="0" FontWeight="Bold" Foreground="#27AE60" FontSize="24"/>
                                            <TextBlock Text="Total Notifications" FontSize="12" Foreground="#555"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1" Background="#E8F4FD" CornerRadius="6" Padding="15" Margin="5">
                                        <StackPanel>
                                            <TextBlock x:Name="AverageDisplayTimeText" Text="0s" FontWeight="Bold" Foreground="#3498DB" FontSize="24"/>
                                            <TextBlock Text="Average Display Time" FontSize="12" Foreground="#555"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="2" Background="#FDF4E8" CornerRadius="6" Padding="15" Margin="5">
                                        <StackPanel>
                                            <TextBlock x:Name="MostActiveTimeText" Text="--:--" FontWeight="Bold" Foreground="#F39C12" FontSize="24"/>
                                            <TextBlock Text="Most Active Hour" FontSize="12" Foreground="#555"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Category Breakdown -->
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,15,0,0">
                                        <TextBlock Text="Category Breakdown:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <StackPanel x:Name="CategoryStatsPanel" Orientation="Vertical"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="Refresh Statistics" Style="{StaticResource ConfigButtonStyle}" Click="RefreshStatisticsBtn_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Category Management Tab -->
            <TabItem Header="Categories">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Notification Categories" Style="{StaticResource SectionHeaderStyle}"/>

                                <!-- Category List -->
                                <DataGrid x:Name="CategoryDataGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Margin="0,0,0,20">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="150"/>
                                        <DataGridTextColumn Header="Default Timeout" Binding="{Binding DefaultTimeout}" Width="120"/>
                                        <DataGridCheckBoxColumn Header="Auto Dismiss" Binding="{Binding AllowAutoDismiss}" Width="100"/>
                                        <DataGridTextColumn Header="Icon" Binding="{Binding IconContent}" Width="80"/>
                                        <DataGridTemplateColumn Header="Actions" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Edit" Style="{StaticResource ConfigButtonStyle}" Padding="8,4" FontSize="11" Margin="2"/>
                                                        <Button Content="Test" Style="{StaticResource SuccessButtonStyle}" Padding="8,4" FontSize="11" Margin="2"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Add Category" Style="{StaticResource SuccessButtonStyle}" Click="AddCategoryBtn_Click"/>
                                    <Button Content="Reset to Defaults" Style="{StaticResource DangerButtonStyle}" Click="ResetCategoriesBtn_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Advanced Settings Tab -->
            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>

                        <!-- Animation Settings -->
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Animation Configuration" Style="{StaticResource SectionHeaderStyle}"/>

                                <Grid Margin="0,0,0,15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Entry Animation:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="EntryAnimationComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,20,0">
                                        <ComboBoxItem Content="None"/>
                                        <ComboBoxItem Content="Fade In"/>
                                        <ComboBoxItem Content="Slide From Right" IsSelected="True"/>
                                        <ComboBoxItem Content="Slide From Left"/>
                                        <ComboBoxItem Content="Scale Up"/>
                                        <ComboBoxItem Content="Bounce In"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Exit Animation:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="ExitAnimationComboBox" Grid.Row="0" Grid.Column="3">
                                        <ComboBoxItem Content="None"/>
                                        <ComboBoxItem Content="Fade Out"/>
                                        <ComboBoxItem Content="Slide To Right" IsSelected="True"/>
                                        <ComboBoxItem Content="Slide To Left"/>
                                        <ComboBoxItem Content="Scale Down"/>
                                        <ComboBoxItem Content="Bounce Out"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Animation Speed:" VerticalAlignment="Center" Margin="0,15,10,0"/>
                                    <ComboBox x:Name="AnimationSpeedComboBox" Grid.Row="1" Grid.Column="1" Margin="0,15,20,0">
                                        <ComboBoxItem Content="Fast"/>
                                        <ComboBoxItem Content="Normal" IsSelected="True"/>
                                        <ComboBoxItem Content="Slow"/>
                                        <ComboBoxItem Content="None"/>
                                    </ComboBox>

                                    <Button Grid.Row="1" Grid.Column="3" Content="Test Animation" Style="{StaticResource ConfigButtonStyle}" Click="TestAnimationBtn_Click" Margin="0,15,0,0" HorizontalAlignment="Left"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- System Behavior -->
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="System Behavior" Style="{StaticResource SectionHeaderStyle}"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Maximum Visible Notifications:" VerticalAlignment="Center" Margin="0,5"/>
                                    <Slider x:Name="MaxNotificationsSlider" Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" Margin="10,5"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Default Auto-Close Delay (seconds):" VerticalAlignment="Center" Margin="0,5"/>
                                    <Slider x:Name="AutoCloseDelaySlider" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="30" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" Margin="10,5"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Notification Spacing (pixels):" VerticalAlignment="Center" Margin="0,5"/>
                                    <Slider x:Name="NotificationSpacingSlider" Grid.Row="2" Grid.Column="1" Minimum="5" Maximum="50" Value="10" TickFrequency="5" IsSnapToTickEnabled="True" Margin="10,5"/>

                                    <CheckBox Grid.Row="3" Grid.ColumnSpan="2" x:Name="EnableHoverPauseCheckBox" Content="Pause auto-close on mouse hover" IsChecked="True" Margin="0,15,0,5"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hotkeys Tab -->
            <TabItem Header="Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>

                        <!-- Hotkey System Status -->
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Hotkey System Status" Style="{StaticResource SectionHeaderStyle}"/>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#E8F5E8" CornerRadius="6" Padding="15" Margin="5">
                                        <StackPanel>
                                            <TextBlock x:Name="HotkeySystemStatusText" Text="Enabled" FontWeight="Bold" Foreground="#27AE60" FontSize="14"/>
                                            <TextBlock Text="Global Hotkeys" FontSize="12" Foreground="#555"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#E8F4FD" CornerRadius="6" Padding="15" Margin="5">
                                        <StackPanel>
                                            <TextBlock x:Name="RegisteredHotkeysText" Text="0 Registered" FontWeight="Bold" Foreground="#3498DB" FontSize="14"/>
                                            <TextBlock Text="Active Hotkeys" FontSize="12" Foreground="#555"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#FDF4E8" CornerRadius="6" Padding="15" Margin="5">
                                        <StackPanel>
                                            <TextBlock x:Name="HotkeyConflictsText" Text="0 Conflicts" FontWeight="Bold" Foreground="#F39C12" FontSize="14"/>
                                            <TextBlock Text="Conflicts" FontSize="12" Foreground="#555"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="ToggleHotkeySystemBtn" Content="Disable Hotkeys" Style="{StaticResource DangerButtonStyle}" Click="ToggleHotkeySystemBtn_Click"/>
                                    <Button x:Name="RefreshHotkeysBtn" Content="Refresh" Style="{StaticResource ConfigButtonStyle}" Click="RefreshHotkeysBtn_Click"/>
                                    <Button x:Name="TestAllHotkeysBtn" Content="Test All" Style="{StaticResource SuccessButtonStyle}" Click="TestAllHotkeysBtn_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Hotkey Management -->
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Hotkey Configuration" Style="{StaticResource SectionHeaderStyle}"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="AddHotkeyBtn" Content="Add Hotkey" Style="{StaticResource SuccessButtonStyle}" Padding="8,4" FontSize="11" Click="AddHotkeyBtn_Click"/>
                                        <Button x:Name="ResetHotkeysBtn" Content="Reset to Defaults" Style="{StaticResource DangerButtonStyle}" Padding="8,4" FontSize="11" Click="ResetHotkeysBtn_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Hotkey List -->
                                <DataGrid x:Name="HotkeyDataGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          SelectionMode="Single"
                                          Margin="0,0,0,20">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="70"/>
                                        <DataGridTextColumn Header="Hotkey" Binding="{Binding DisplayName}" Width="150" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="Actions" Width="250">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Edit" Style="{StaticResource ConfigButtonStyle}" Padding="6,2" FontSize="10" Margin="2" Click="EditHotkeyBtn_Click" Tag="{Binding}"/>
                                                        <Button Content="Test" Style="{StaticResource SuccessButtonStyle}" Padding="6,2" FontSize="10" Margin="2" Click="TestHotkeyBtn_Click" Tag="{Binding}"/>
                                                        <Button Content="Clone" Style="{StaticResource SecondaryButtonStyle}" Padding="6,2" FontSize="10" Margin="2" Click="CloneHotkeyBtn_Click" Tag="{Binding}"/>
                                                        <Button Content="Delete" Style="{StaticResource DangerButtonStyle}" Padding="6,2" FontSize="10" Margin="2" Click="DeleteHotkeyBtn_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Hotkey Help -->
                                <Border Background="#F8F9FA" CornerRadius="6" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="Hotkey Guidelines" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Recommended:" FontWeight="SemiBold" FontSize="11" Foreground="#27AE60" Margin="0,0,0,5"/>
                                                <TextBlock Text="• Use Ctrl+Shift+[Key] for global actions" FontSize="10" Foreground="#555" Margin="0,0,0,2"/>
                                                <TextBlock Text="• Function keys (F1-F12) with modifiers" FontSize="10" Foreground="#555" Margin="0,0,0,2"/>
                                                <TextBlock Text="• Letters A-Z with two or more modifiers" FontSize="10" Foreground="#555" Margin="0,0,0,2"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Avoid:" FontWeight="SemiBold" FontSize="11" Foreground="#E74C3C" Margin="0,0,0,5"/>
                                                <TextBlock Text="• System hotkeys (Alt+Tab, Ctrl+Alt+Del)" FontSize="10" Foreground="#555" Margin="0,0,0,2"/>
                                                <TextBlock Text="• Single keys without modifiers" FontSize="10" Foreground="#555" Margin="0,0,0,2"/>
                                                <TextBlock Text="• Common application shortcuts" FontSize="10" Foreground="#555" Margin="0,0,0,2"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>

                        <!-- Application Settings -->
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Application Settings" Style="{StaticResource SectionHeaderStyle}"/>

                                <StackPanel>
                                    <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows" Margin="0,5"/>
                                    <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Minimize to system tray" IsChecked="True" Margin="0,5"/>
                                    <CheckBox x:Name="ShowConfigOnStartupCheckBox" Content="Show configuration on startup" Margin="0,5"/>
                                    <CheckBox x:Name="CollectStatisticsCheckBox" Content="Collect usage statistics" IsChecked="True" Margin="0,5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Data Management -->
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Data Management" Style="{StaticResource SectionHeaderStyle}"/>

                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Export Settings" Style="{StaticResource ConfigButtonStyle}" Click="ExportSettingsBtn_Click"/>
                                    <Button Content="Import Settings" Style="{StaticResource SecondaryButtonStyle}" Click="ImportSettingsBtn_Click"/>
                                    <Button Content="Reset to Defaults" Style="{StaticResource DangerButtonStyle}" Click="ResetSettingsBtn_Click"/>
                                    <Button Content="Create Backup" Style="{StaticResource SuccessButtonStyle}" Click="CreateBackupBtn_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Schedule Tab -->
            <TabItem Header="Schedule">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>

                        <!-- Schedule System Status -->
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Schedule System" Style="{StaticResource SectionHeaderStyle}"/>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#E8F5E8" CornerRadius="6" Padding="15" Margin="5">
                                        <StackPanel>
                                            <TextBlock x:Name="SchedulingStatusText" Text="Enabled" FontWeight="Bold" Foreground="#27AE60" FontSize="14"/>
                                            <TextBlock Text="Scheduling System" FontSize="12" Foreground="#555"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#E8F4FD" CornerRadius="6" Padding="15" Margin="5">
                                        <StackPanel>
                                            <TextBlock x:Name="ActiveSchedulesText" Text="0 Active" FontWeight="Bold" Foreground="#3498DB" FontSize="14"/>
                                            <TextBlock Text="Schedules" FontSize="12" Foreground="#555"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#FDF4E8" CornerRadius="6" Padding="15" Margin="5">
                                        <StackPanel>
                                            <TextBlock x:Name="NextScheduleText" Text="None" FontWeight="Bold" Foreground="#F39C12" FontSize="14"/>
                                            <TextBlock Text="Next Notification" FontSize="12" Foreground="#555"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="ToggleSchedulingBtn" Content="Disable Scheduling" Style="{StaticResource DangerButtonStyle}" Click="ToggleSchedulingBtn_Click"/>
                                    <Button x:Name="RefreshSchedulesBtn" Content="Refresh" Style="{StaticResource ConfigButtonStyle}" Click="RefreshSchedulesBtn_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Schedule Creation -->
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Create New Schedule" Style="{StaticResource SectionHeaderStyle}"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Schedule Name -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Schedule Name:" VerticalAlignment="Center" Margin="0,5"/>
                                    <TextBox x:Name="ScheduleNameTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="10,5" Padding="8" Text="My Reminder"/>

                                    <!-- Notification Content -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Title:" VerticalAlignment="Center" Margin="0,5"/>
                                    <TextBox x:Name="NotificationTitleTextBox" Grid.Row="1" Grid.Column="1" Margin="10,5" Padding="8" Text="Reminder"/>

                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Message:" VerticalAlignment="Center" Margin="0,5"/>
                                    <TextBox x:Name="NotificationMessageTextBox" Grid.Row="1" Grid.Column="3" Margin="10,5" Padding="8" Text="Time for a break!"/>

                                    <!-- Category and Priority -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Category:" VerticalAlignment="Center" Margin="0,5"/>
                                    <ComboBox x:Name="NotificationCategoryComboBox" Grid.Row="2" Grid.Column="1" Margin="10,5" SelectedIndex="0">
                                        <ComboBoxItem Content="Info"/>
                                        <ComboBoxItem Content="Success"/>
                                        <ComboBoxItem Content="Warning"/>
                                        <ComboBoxItem Content="Error"/>
                                        <ComboBoxItem Content="System"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Priority:" VerticalAlignment="Center" Margin="0,5"/>
                                    <ComboBox x:Name="NotificationPriorityComboBox" Grid.Row="2" Grid.Column="3" Margin="10,5" SelectedIndex="1">
                                        <ComboBoxItem Content="Low"/>
                                        <ComboBoxItem Content="Normal"/>
                                        <ComboBoxItem Content="High"/>
                                        <ComboBoxItem Content="Critical"/>
                                    </ComboBox>

                                    <!-- Start Time -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Start Time:" VerticalAlignment="Center" Margin="0,5"/>
                                    <DatePicker x:Name="StartDatePicker" Grid.Row="3" Grid.Column="1" Margin="10,5" SelectedDate="{x:Static System:DateTime.Now}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Start Hour:" VerticalAlignment="Center" Margin="0,5"/>
                                    <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" Margin="10,5">
                                        <ComboBox x:Name="StartHourComboBox" Width="60" Margin="0,0,5,0">
                                            <!-- Will be populated in code-behind -->
                                        </ComboBox>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="5,0"/>
                                        <ComboBox x:Name="StartMinuteComboBox" Width="60" Margin="5,0,0,0">
                                            <!-- Will be populated in code-behind -->
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Recurrence Settings -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Recurrence:" VerticalAlignment="Center" Margin="0,5"/>
                                    <ComboBox x:Name="RecurrenceComboBox" Grid.Row="4" Grid.Column="1" Margin="10,5" SelectionChanged="RecurrenceComboBox_SelectionChanged">
                                        <ComboBoxItem Content="One Time" IsSelected="True"/>
                                        <ComboBoxItem Content="Every N Minutes"/>
                                        <ComboBoxItem Content="Every N Hours"/>
                                        <ComboBoxItem Content="Every N Days"/>
                                        <ComboBoxItem Content="Weekly"/>
                                        <ComboBoxItem Content="Monthly"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Interval:" VerticalAlignment="Center" Margin="0,5" x:Name="IntervalLabel"/>
                                    <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal" Margin="10,5" x:Name="IntervalPanel">
                                        <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,5,0" x:Name="EveryLabel"/>
                                        <TextBox x:Name="IntervalValueTextBox" Width="60" Padding="4" Text="1"/>
                                        <TextBlock x:Name="IntervalUnitLabel" Text="time" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Row="5" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                        <Button x:Name="CreateScheduleBtn" Content="Create Schedule" Style="{StaticResource SuccessButtonStyle}" Click="CreateScheduleBtn_Click"/>
                                        <Button x:Name="TestScheduleBtn" Content="Test Now" Style="{StaticResource ConfigButtonStyle}" Click="TestScheduleBtn_Click"/>
                                        <Button x:Name="ClearFormBtn" Content="Clear Form" Style="{StaticResource SecondaryButtonStyle}" Click="ClearFormBtn_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Schedule Management -->
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Existing Schedules" Style="{StaticResource SectionHeaderStyle}"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="DeleteSelectedBtn" Content="Delete Selected" Style="{StaticResource DangerButtonStyle}" Padding="8,4" FontSize="11" Click="DeleteSelectedBtn_Click"/>
                                        <Button x:Name="ClearAllSchedulesBtn" Content="Clear All" Style="{StaticResource DangerButtonStyle}" Padding="8,4" FontSize="11" Click="ClearAllSchedulesBtn_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Schedule List -->
                                <DataGrid x:Name="ScheduleDataGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          SelectionMode="Single"
                                          Margin="0,0,0,20">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="70"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                                        <DataGridTextColumn Header="Title" Binding="{Binding NotificationTemplate.Title}" Width="120"/>
                                        <DataGridTextColumn Header="Recurrence" Binding="{Binding Recurrence}" Width="100"/>
                                        <DataGridTextColumn Header="Next Run" Binding="{Binding NextTriggerTime, StringFormat='{}{0:MM/dd HH:mm}'}" Width="100"/>
                                        <DataGridTextColumn Header="Triggers" Binding="{Binding TriggerCount}" Width="70"/>
                                        <DataGridTemplateColumn Header="Actions" Width="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Edit" Style="{StaticResource ConfigButtonStyle}" Padding="6,2" FontSize="10" Margin="2" Click="EditScheduleBtn_Click"/>
                                                        <Button Content="Test" Style="{StaticResource SuccessButtonStyle}" Padding="6,2" FontSize="10" Margin="2" Click="TestExistingScheduleBtn_Click"/>
                                                        <Button Content="Clone" Style="{StaticResource SecondaryButtonStyle}" Padding="6,2" FontSize="10" Margin="2" Click="CloneScheduleBtn_Click"/>
                                                        <Button Content="Delete" Style="{StaticResource DangerButtonStyle}" Padding="6,2" FontSize="10" Margin="2" Click="DeleteScheduleBtn_Click"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Schedule Statistics -->
                                <Border Background="#F8F9FA" CornerRadius="6" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="Schedule Statistics" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock x:Name="TotalSchedulesText" Text="0" FontWeight="Bold" FontSize="18" Foreground="#2C3E50"/>
                                                <TextBlock Text="Total Schedules" FontSize="10" Foreground="#7F8C8D"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="EnabledSchedulesText" Text="0" FontWeight="Bold" FontSize="18" Foreground="#27AE60"/>
                                                <TextBlock Text="Enabled" FontSize="10" Foreground="#7F8C8D"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="RecurringSchedulesText" Text="0" FontWeight="Bold" FontSize="18" Foreground="#3498DB"/>
                                                <TextBlock Text="Recurring" FontSize="10" Foreground="#7F8C8D"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3">
                                                <TextBlock x:Name="TotalTriggersText" Text="0" FontWeight="Bold" FontSize="18" Foreground="#9B59B6"/>
                                                <TextBlock Text="Total Triggers" FontSize="10" Foreground="#7F8C8D"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>




        <!-- Footer -->
        <Border Grid.Row="2" Background="#34495E" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Phase 5 Implementation: Advanced Configuration Dashboard and Management Interface"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#BDC3C7"/>
                    <TextBlock Text="Features: System tray integration, Theme editor, Statistics dashboard, Category management, Advanced settings"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               Foreground="#95A5A6"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Ready" FontFamily="Segoe UI" FontSize="12" Foreground="#BDC3C7" Margin="0,0,20,0"/>
                    <Button Content="About" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="11" Click="AboutBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
