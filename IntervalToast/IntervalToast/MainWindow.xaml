<Window x:Class="IntervalToast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IntervalToast"
        mc:Ignorable="d"
        Title="IntervalToast - Notification Demo" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Button style -->
        <Style x:Key="DemoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5BA0F2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3A80D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox style -->
        <Style x:Key="DemoComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <StackPanel>
                <TextBlock Text="IntervalToast Notification System"
                           FontFamily="Segoe UI"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Phase 3: Enhanced Stacking and Advanced Management"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           Foreground="#BDC3C7"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel MaxWidth="600">

                <!-- Basic Notifications Section -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Basic Notifications"
                                   FontFamily="Segoe UI"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,15"/>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="ShowDefaultBtn"
                                    Content="Show Default Notification"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowDefaultBtn_Click"/>

                            <Button x:Name="ShowCustomMessageBtn"
                                    Content="Show Custom Message"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowCustomMessageBtn_Click"/>

                            <Button x:Name="ShowMultipleBtn"
                                    Content="Show Multiple Notifications"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowMultipleBtn_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Themed Notifications Section -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Themed Notifications"
                                   FontFamily="Segoe UI"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,15"/>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="ShowLightThemeBtn"
                                    Content="Light Theme"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowLightThemeBtn_Click"/>

                            <Button x:Name="ShowDarkThemeBtn"
                                    Content="Dark Theme"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowDarkThemeBtn_Click"/>

                            <Button x:Name="ShowMinimalBtn"
                                    Content="Minimal Style"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowMinimalBtn_Click"/>

                            <Button x:Name="ShowLargeBtn"
                                    Content="Large Notification"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowLargeBtn_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Animation Presets Section -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Animation Presets"
                                   FontFamily="Segoe UI"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,15"/>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="ShowFastAnimationBtn"
                                    Content="Fast Animation"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowFastAnimationBtn_Click"/>

                            <Button x:Name="ShowNormalAnimationBtn"
                                    Content="Normal Animation"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowNormalAnimationBtn_Click"/>

                            <Button x:Name="ShowSmoothAnimationBtn"
                                    Content="Smooth Animation"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowSmoothAnimationBtn_Click"/>

                            <Button x:Name="ShowBounceAnimationBtn"
                                    Content="Bounce Animation"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowBounceAnimationBtn_Click"/>

                            <Button x:Name="ShowNoAnimationBtn"
                                    Content="No Animation"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowNoAnimationBtn_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Entry/Exit Animation Testing Section -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Entry &amp; Exit Animations"
                                   FontFamily="Segoe UI"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Entry:"
                                       FontFamily="Segoe UI"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <ComboBox x:Name="EntryAnimationComboBox"
                                      Grid.Column="1"
                                      Style="{StaticResource DemoComboBoxStyle}"
                                      SelectedIndex="2">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="Fade In"/>
                                <ComboBoxItem Content="Slide From Right"/>
                                <ComboBoxItem Content="Slide From Left"/>
                                <ComboBoxItem Content="Slide From Top"/>
                                <ComboBoxItem Content="Slide From Bottom"/>
                                <ComboBoxItem Content="Scale Up"/>
                                <ComboBoxItem Content="Bounce In"/>
                                <ComboBoxItem Content="Fly In"/>
                            </ComboBox>

                            <TextBlock Grid.Column="2"
                                       Text="Exit:"
                                       FontFamily="Segoe UI"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="20,0,10,0"/>

                            <ComboBox x:Name="ExitAnimationComboBox"
                                      Grid.Column="3"
                                      Style="{StaticResource DemoComboBoxStyle}"
                                      SelectedIndex="2">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="Fade Out"/>
                                <ComboBoxItem Content="Slide To Right"/>
                                <ComboBoxItem Content="Slide To Left"/>
                                <ComboBoxItem Content="Slide To Top"/>
                                <ComboBoxItem Content="Slide To Bottom"/>
                                <ComboBoxItem Content="Scale Down"/>
                                <ComboBoxItem Content="Bounce Out"/>
                                <ComboBoxItem Content="Fly Out"/>
                            </ComboBox>
                        </Grid>

                        <Button x:Name="TestCustomAnimationBtn"
                                Content="Test Custom Animation"
                                Style="{StaticResource DemoButtonStyle}"
                                Click="TestCustomAnimationBtn_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Progress Indicator Testing Section -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Progress Indicators"
                                   FontFamily="Segoe UI"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Style:"
                                       FontFamily="Segoe UI"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <ComboBox x:Name="ProgressStyleComboBox"
                                      Grid.Column="1"
                                      Style="{StaticResource DemoComboBoxStyle}"
                                      SelectedIndex="1">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="Bottom Bar"/>
                                <ComboBoxItem Content="Top Bar"/>
                                <ComboBoxItem Content="Circular Corner"/>
                                <ComboBoxItem Content="Circular Center"/>
                                <ComboBoxItem Content="Left Border"/>
                                <ComboBoxItem Content="Right Border"/>
                            </ComboBox>

                            <Button x:Name="TestProgressBtn"
                                    Grid.Column="2"
                                    Content="Test Progress"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="TestProgressBtn_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Visual Effects Section -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Visual Effects"
                                   FontFamily="Segoe UI"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,15"/>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="ShowGlowEffectBtn"
                                    Content="Glow Effect"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowGlowEffectBtn_Click"/>

                            <Button x:Name="ShowBlurEffectBtn"
                                    Content="Blur Effect"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowBlurEffectBtn_Click"/>

                            <Button x:Name="ShowHoverEffectsBtn"
                                    Content="Enhanced Hover"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowHoverEffectsBtn_Click"/>

                            <Button x:Name="ShowCombinedEffectsBtn"
                                    Content="Combined Effects"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowCombinedEffectsBtn_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Phase 3: Category and Priority Testing Section -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Category &amp; Priority Notifications"
                                   FontFamily="Segoe UI"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,15"/>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="ShowInfoNotificationBtn"
                                    Content="Info Notification"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Background="#4A90E2"
                                    Click="ShowInfoNotificationBtn_Click"/>

                            <Button x:Name="ShowSuccessNotificationBtn"
                                    Content="Success Notification"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Background="#4CAF50"
                                    Click="ShowSuccessNotificationBtn_Click"/>

                            <Button x:Name="ShowWarningNotificationBtn"
                                    Content="Warning Notification"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Background="#FF9800"
                                    Click="ShowWarningNotificationBtn_Click"/>

                            <Button x:Name="ShowErrorNotificationBtn"
                                    Content="Error Notification"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Background="#F44336"
                                    Click="ShowErrorNotificationBtn_Click"/>

                            <Button x:Name="ShowSystemNotificationBtn"
                                    Content="System Notification"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Background="#9E9E9E"
                                    Click="ShowSystemNotificationBtn_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Phase 3: Priority Testing Section -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Priority Level Testing"
                                   FontFamily="Segoe UI"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,15"/>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="ShowLowPriorityBtn"
                                    Content="Low Priority"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Background="#9E9E9E"
                                    Click="ShowLowPriorityBtn_Click"/>

                            <Button x:Name="ShowNormalPriorityBtn"
                                    Content="Normal Priority"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Background="#4A90E2"
                                    Click="ShowNormalPriorityBtn_Click"/>

                            <Button x:Name="ShowHighPriorityBtn"
                                    Content="High Priority"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Background="#FF9800"
                                    Click="ShowHighPriorityBtn_Click"/>

                            <Button x:Name="ShowCriticalPriorityBtn"
                                    Content="Critical Priority"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Background="#F44336"
                                    Click="ShowCriticalPriorityBtn_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Phase 3: Advanced Stacking Testing Section -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Advanced Stacking &amp; Management"
                                   FontFamily="Segoe UI"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,15"/>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="TestCompactModeBtn"
                                    Content="Test Compact Mode"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="TestCompactModeBtn_Click"/>

                            <Button x:Name="TestOverflowHandlingBtn"
                                    Content="Test Overflow (10 notifications)"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="TestOverflowHandlingBtn_Click"/>

                            <Button x:Name="TestPriorityOrderingBtn"
                                    Content="Test Priority Ordering"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="TestPriorityOrderingBtn_Click"/>

                            <Button x:Name="TestCategoryGroupingBtn"
                                    Content="Test Category Grouping"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="TestCategoryGroupingBtn_Click"/>

                            <Button x:Name="ShowQueueStatusBtn"
                                    Content="Show Queue Status"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="ShowQueueStatusBtn_Click"/>

                            <Button x:Name="ClearAllNotificationsBtn"
                                    Content="Clear All Notifications"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Background="#F44336"
                                    Click="ClearAllNotificationsBtn_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Position Testing Section -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Position Testing"
                                   FontFamily="Segoe UI"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Position:"
                                       FontFamily="Segoe UI"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <ComboBox x:Name="PositionComboBox"
                                      Grid.Column="1"
                                      Style="{StaticResource DemoComboBoxStyle}"
                                      SelectedIndex="2">
                                <ComboBoxItem Content="Top Right"/>
                                <ComboBoxItem Content="Top Left"/>
                                <ComboBoxItem Content="Bottom Right"/>
                                <ComboBoxItem Content="Bottom Left"/>
                                <ComboBoxItem Content="Top Center"/>
                                <ComboBoxItem Content="Bottom Center"/>
                            </ComboBox>

                            <Button x:Name="TestPositionBtn"
                                    Grid.Column="2"
                                    Content="Test Position"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Click="TestPositionBtn_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Global Hotkey Configuration Section -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Global Hotkey Configuration"
                                   FontFamily="Segoe UI"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,15"/>

                        <!-- System Enable/Disable Toggle -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="EnableHotkeysCheckBox"
                                      Grid.Column="0"
                                      Content="Enable Global Hotkeys"
                                      FontFamily="Segoe UI"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"
                                      IsChecked="True"
                                      Checked="EnableHotkeysCheckBox_Changed"
                                      Unchecked="EnableHotkeysCheckBox_Changed"/>

                            <TextBlock x:Name="HotkeySystemStatusText"
                                       Grid.Column="1"
                                       Text="System Active"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       Foreground="#27AE60"
                                       VerticalAlignment="Center"
                                       Margin="15,0,0,0"/>

                            <Button x:Name="ResetHotkeysBtn"
                                    Grid.Column="2"
                                    Content="Reset to Defaults"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Background="#E67E22"
                                    Click="ResetHotkeysBtn_Click"
                                    Margin="0"/>
                        </Grid>

                        <!-- Hotkey Configuration Controls -->
                        <GroupBox Header="Hotkey Assignments"
                                  FontFamily="Segoe UI"
                                  FontWeight="SemiBold"
                                  FontSize="14"
                                  Margin="0,0,0,15"
                                  Padding="15">
                            <StackPanel>

                                <!-- Dismiss All Notifications Hotkey -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Dismiss All:"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>

                                    <Border x:Name="DismissAllHotkeyBorder"
                                            Grid.Column="1"
                                            Background="#F8F9FA"
                                            BorderBrush="#BDC3C7"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,6"
                                            Margin="5,0"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="DismissAllHotkey_Click">
                                        <TextBlock x:Name="DismissAllHotkeyText"
                                                   Text="Ctrl + Shift + D"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   Foreground="#2C3E50"/>
                                    </Border>

                                    <Ellipse x:Name="DismissAllStatusIndicator"
                                             Grid.Column="2"
                                             Width="12"
                                             Height="12"
                                             Fill="#27AE60"
                                             Margin="5,0"
                                             ToolTip="Hotkey registered successfully"/>

                                    <Button x:Name="TestDismissAllBtn"
                                            Grid.Column="3"
                                            Content="Test"
                                            Style="{StaticResource DemoButtonStyle}"
                                            Background="#3498DB"
                                            FontSize="10"
                                            Padding="8,4"
                                            Margin="5,0"
                                            Click="TestDismissAllBtn_Click"/>

                                    <Button x:Name="EditDismissAllBtn"
                                            Grid.Column="4"
                                            Content="Edit"
                                            Style="{StaticResource DemoButtonStyle}"
                                            Background="#9B59B6"
                                            FontSize="10"
                                            Padding="8,4"
                                            Margin="5,0,0,0"
                                            Click="EditDismissAllBtn_Click"/>
                                </Grid>

                                <!-- Dismiss Latest Notification Hotkey -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Dismiss Latest:"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>

                                    <Border x:Name="DismissLatestHotkeyBorder"
                                            Grid.Column="1"
                                            Background="#F8F9FA"
                                            BorderBrush="#BDC3C7"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,6"
                                            Margin="5,0"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="DismissLatestHotkey_Click">
                                        <TextBlock x:Name="DismissLatestHotkeyText"
                                                   Text="Ctrl + Shift + Esc"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   Foreground="#2C3E50"/>
                                    </Border>

                                    <Ellipse x:Name="DismissLatestStatusIndicator"
                                             Grid.Column="2"
                                             Width="12"
                                             Height="12"
                                             Fill="#27AE60"
                                             Margin="5,0"
                                             ToolTip="Hotkey registered successfully"/>

                                    <Button x:Name="TestDismissLatestBtn"
                                            Grid.Column="3"
                                            Content="Test"
                                            Style="{StaticResource DemoButtonStyle}"
                                            Background="#3498DB"
                                            FontSize="10"
                                            Padding="8,4"
                                            Margin="5,0"
                                            Click="TestDismissLatestBtn_Click"/>

                                    <Button x:Name="EditDismissLatestBtn"
                                            Grid.Column="4"
                                            Content="Edit"
                                            Style="{StaticResource DemoButtonStyle}"
                                            Background="#9B59B6"
                                            FontSize="10"
                                            Padding="8,4"
                                            Margin="5,0,0,0"
                                            Click="EditDismissLatestBtn_Click"/>
                                </Grid>

                                <!-- Toggle System Hotkey -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Toggle System:"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>

                                    <Border x:Name="ToggleSystemHotkeyBorder"
                                            Grid.Column="1"
                                            Background="#F8F9FA"
                                            BorderBrush="#BDC3C7"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,6"
                                            Margin="5,0"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="ToggleSystemHotkey_Click">
                                        <TextBlock x:Name="ToggleSystemHotkeyText"
                                                   Text="Ctrl + Shift + P"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   Foreground="#2C3E50"/>
                                    </Border>

                                    <Ellipse x:Name="ToggleSystemStatusIndicator"
                                             Grid.Column="2"
                                             Width="12"
                                             Height="12"
                                             Fill="#27AE60"
                                             Margin="5,0"
                                             ToolTip="Hotkey registered successfully"/>

                                    <Button x:Name="TestToggleSystemBtn"
                                            Grid.Column="3"
                                            Content="Test"
                                            Style="{StaticResource DemoButtonStyle}"
                                            Background="#3498DB"
                                            FontSize="10"
                                            Padding="8,4"
                                            Margin="5,0"
                                            Click="TestToggleSystemBtn_Click"/>

                                    <Button x:Name="EditToggleSystemBtn"
                                            Grid.Column="4"
                                            Content="Edit"
                                            Style="{StaticResource DemoButtonStyle}"
                                            Background="#9B59B6"
                                            FontSize="10"
                                            Padding="8,4"
                                            Margin="5,0,0,0"
                                            Click="EditToggleSystemBtn_Click"/>
                                </Grid>

                                <!-- Show Queue Status Hotkey -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Show Queue Status:"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>

                                    <Border x:Name="ShowQueueStatusHotkeyBorder"
                                            Grid.Column="1"
                                            Background="#F8F9FA"
                                            BorderBrush="#BDC3C7"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,6"
                                            Margin="5,0"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="ShowQueueStatusHotkey_Click">
                                        <TextBlock x:Name="ShowQueueStatusHotkeyText"
                                                   Text="Ctrl + Shift + Q"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   Foreground="#2C3E50"/>
                                    </Border>

                                    <Ellipse x:Name="ShowQueueStatusStatusIndicator"
                                             Grid.Column="2"
                                             Width="12"
                                             Height="12"
                                             Fill="#27AE60"
                                             Margin="5,0"
                                             ToolTip="Hotkey registered successfully"/>

                                    <Button x:Name="TestShowQueueStatusBtn"
                                            Grid.Column="3"
                                            Content="Test"
                                            Style="{StaticResource DemoButtonStyle}"
                                            Background="#3498DB"
                                            FontSize="10"
                                            Padding="8,4"
                                            Margin="5,0"
                                            Click="TestShowQueueStatusBtn_Click"/>

                                    <Button x:Name="EditShowQueueStatusBtn"
                                            Grid.Column="4"
                                            Content="Edit"
                                            Style="{StaticResource DemoButtonStyle}"
                                            Background="#9B59B6"
                                            FontSize="10"
                                            Padding="8,4"
                                            Margin="5,0,0,0"
                                            Click="EditShowQueueStatusBtn_Click"/>
                                </Grid>

                            </StackPanel>
                        </GroupBox>

                        <!-- Hotkey Configuration Status -->
                        <Border Background="#F8F9FA"
                                CornerRadius="4"
                                Padding="10"
                                Margin="0,0,0,15">
                            <TextBlock x:Name="HotkeyConfigStatusText"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="#7F8C8D"
                                       TextWrapping="Wrap"
                                       Text="All hotkeys registered successfully. Click 'Edit' to change key combinations or use 'Test' to verify functionality."/>
                        </Border>

                        <!-- Action Buttons -->
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="TestAllHotkeysBtn"
                                    Content="Test All Hotkeys"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Background="#16A085"
                                    Click="TestAllHotkeysBtn_Click"/>

                            <Button x:Name="RefreshHotkeyStatusBtn"
                                    Content="Refresh Status"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Background="#34495E"
                                    Click="RefreshHotkeyStatusBtn_Click"/>
                        </WrapPanel>

                    </StackPanel>
                </Border>

                <!-- System Information Section -->
                <Border Background="White" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="System Information"
                                   FontFamily="Segoe UI"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,15"/>

                        <TextBlock x:Name="SystemInfoTextBlock"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="#555"
                                   Background="#F8F9FA"
                                   Padding="10"
                                   TextWrapping="Wrap"
                                   Text="Loading system information..."/>

                        <Button x:Name="RefreshSystemInfoBtn"
                                Content="Refresh System Info"
                                Style="{StaticResource DemoButtonStyle}"
                                Click="RefreshSystemInfoBtn_Click"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#34495E" Padding="15">
            <StackPanel>
                <TextBlock Text="Phase 3 Implementation: Enhanced notification stacking and advanced management with category/priority system"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="#BDC3C7"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Features: Category indicators, Priority ordering, Intelligent spacing, Overflow handling, Summary notifications, Queue management"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           Foreground="#95A5A6"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
