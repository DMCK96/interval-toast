<Window x:Class="IntervalToast.Presentation.Windows.HotkeyEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Edit Hotkey"
        Height="320"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#F8F9FA">

    <Window.Resources>
        <!-- Button style matching MainWindow -->
        <Style x:Key="EditButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5BA0F2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3A80D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   x:Name="HeaderText"
                   Text="Edit Hotkey: Dismiss All Notifications"
                   FontFamily="Segoe UI"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,20"/>

        <!-- Current Hotkey Display -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#BDC3C7"
                BorderThickness="1"
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Current Hotkey:"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="#7F8C8D"
                           Margin="0,0,0,5"/>
                <TextBlock x:Name="CurrentHotkeyText"
                           Text="Ctrl + Shift + D"
                           FontFamily="Segoe UI"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#2C3E50"/>
            </StackPanel>
        </Border>

        <!-- Hotkey Capture Area -->
        <Border Grid.Row="2"
                x:Name="CaptureArea"
                Background="#ECF0F1"
                BorderBrush="#3498DB"
                BorderThickness="2"
                CornerRadius="6"
                Padding="20"
                Margin="0,0,0,15"
                Cursor="Hand"
                MouseLeftButtonDown="CaptureArea_Click">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="CaptureInstructionText"
                           Text="Click here and press your desired key combination"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           Foreground="#34495E"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock x:Name="CapturedHotkeyText"
                           Text=""
                           FontFamily="Segoe UI"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#2C3E50"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="ValidationMessageText"
                           Text=""
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="#E74C3C"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Status and Help Information -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#BDC3C7"
                BorderThickness="1"
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Guidelines:"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#2C3E50"
                           Margin="0,0,0,8"/>

                <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap">
                    <Run Text="• Use modifier keys (Ctrl, Alt, Shift) for global hotkeys"/>
                    <LineBreak/>
                    <Run Text="• Avoid system hotkeys (like Alt+Tab, Ctrl+Alt+Del)"/>
                    <LineBreak/>
                    <Run Text="• Function keys (F1-F12) with modifiers work well"/>
                    <LineBreak/>
                    <Run Text="• Press Escape to cancel editing"/>
                </TextBlock>

                <Border Background="#E8F6F3"
                        BorderBrush="#27AE60"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,10,0,0"
                        x:Name="ConflictWarningBorder"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ConflictWarningText"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#27AE60"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="TestButton"
                    Grid.Column="1"
                    Content="Test"
                    Style="{StaticResource EditButtonStyle}"
                    Background="#16A085"
                    Click="TestButton_Click"
                    IsEnabled="False"/>

            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    Content="Save"
                    Style="{StaticResource EditButtonStyle}"
                    Background="#27AE60"
                    Click="SaveButton_Click"
                    IsEnabled="False"/>

            <Button x:Name="CancelButton"
                    Grid.Column="3"
                    Content="Cancel"
                    Style="{StaticResource EditButtonStyle}"
                    Background="#95A5A6"
                    Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>