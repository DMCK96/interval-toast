<Window x:Class="IntervalToast.Presentation.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:IntervalToast.Presentation.ViewModels"
        xmlns:local="clr-namespace:IntervalToast.Presentation.Converters"
        mc:Ignorable="d"
        Title="IntervalToast Configuration"
        Height="600" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen">


    <Window.Resources>
        <!-- Value Converters -->
        <local:BoolToEnabledConverter x:Key="BoolToEnabledConverter"/>
        <local:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <local:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:BoolToStatusTextConverter x:Key="BoolToStatusTextConverter"/>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Gray"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="IntervalToast Configuration Dashboard"
                               Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource StatusTextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="System: " Style="{StaticResource StatusTextStyle}"/>
                    <TextBlock Text="{Binding IsSystemEnabled, Converter={StaticResource BoolToEnabledConverter}}"
                               Style="{StaticResource StatusTextStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="10">

            <!-- Dashboard Tab -->
            <TabItem Header="Dashboard">
                <ScrollViewer>
                    <StackPanel Margin="10">

                        <!-- Quick Actions -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Quick Actions" Style="{StaticResource HeaderTextStyle}"/>
                                <WrapPanel>
                                    <Button Content="Test Notification"
                                            Command="{Binding ShowTestNotificationCommand}"
                                            Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Content="Dismiss All"
                                            Command="{Binding DismissAllNotificationsCommand}"
                                            Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Content="Refresh Status"
                                            Command="{Binding RefreshNotificationStatusCommand}"
                                            Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Content="Settings"
                                            Command="{Binding OpenSettingsCommand}"
                                            Style="{StaticResource ActionButtonStyle}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Status Overview -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Status Overview" Style="{StaticResource HeaderTextStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Active Notifications" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ActiveNotificationCount}"
                                                   FontSize="24" FontWeight="Bold" Foreground="Blue"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Pending Notifications" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding PendingNotificationCount}"
                                                   FontSize="24" FontWeight="Bold" Foreground="Orange"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="System Status" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding IsSystemEnabled, Converter={StaticResource BoolToStatusConverter}}"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="{Binding IsSystemEnabled, Converter={StaticResource BoolToColorConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Recent Notifications -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Recent Notifications" Style="{StaticResource HeaderTextStyle}"/>
                                <ListView ItemsSource="{Binding RecentNotifications}"
                                          MaxHeight="200"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="200"/>
                                            <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="100"/>
                                            <GridViewColumn Header="Priority" DisplayMemberBinding="{Binding Priority}" Width="100"/>
                                            <GridViewColumn Header="Created" DisplayMemberBinding="{Binding CreatedAt, StringFormat=HH:mm:ss}" Width="100"/>
                                            <GridViewColumn Header="Status" Width="100">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding IsDismissed, Converter={StaticResource BoolToStatusTextConverter}}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hotkeys Tab -->
            <TabItem Header="Hotkeys">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Hotkey Bindings" Style="{StaticResource HeaderTextStyle}"/>
                                    <Button Content="Refresh"
                                            Command="{Binding RefreshHotkeyBindingsCommand}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Style="{StaticResource ActionButtonStyle}"/>
                                </Grid>

                                <ListView ItemsSource="{Binding HotkeyBindings}"
                                          MinHeight="300"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="150"/>
                                            <GridViewColumn Header="Hotkey" DisplayMemberBinding="{Binding HotkeyText}" Width="150"/>
                                            <GridViewColumn Header="Action" DisplayMemberBinding="{Binding Action}" Width="200"/>
                                            <GridViewColumn Header="Enabled" Width="80">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsEnabled}" IsEnabled="False"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Registered" Width="80">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsRegistered}" IsEnabled="False"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Usage" DisplayMemberBinding="{Binding UsageCount}" Width="60"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Application Settings" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Text="Settings configuration will be implemented here"
                                           Style="{StaticResource StatusTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="100" Height="16"
                             IsIndeterminate="{Binding IsLoading}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>